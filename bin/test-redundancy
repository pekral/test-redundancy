#!/usr/bin/env php
<?php

declare(strict_types = 1);

use Pekral\TestRedundancy\Console\Application;

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

ini_set('memory_limit', '-1');

$application = new Application((string) getcwd());

/** @var list<string> $arguments */
$arguments = $_SERVER['argv'];

exit($application->run(new Symfony\Component\Console\Input\ArgvInput($application->withDefaultCommand($arguments))));
